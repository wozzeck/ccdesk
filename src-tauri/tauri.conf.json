{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccdesk",
  "version": "0.1.0",
  "identifier": "org.wzk.ccdesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ccdesk",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "tmux"
        ]
      }
    }
  }
}
